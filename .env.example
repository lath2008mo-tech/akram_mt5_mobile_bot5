# ---------- API / mobil ----------
# Leave empty to auto-generate a token into .api_token
API_TOKEN=

# ---------- MT5 ----------
# Only needed if auto-detect fails
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
DRY_RUN=true

# ---------- instrument ----------
SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD
TIMEFRAME_MINUTES=5
BARS=300

# ---------- risk (the part that keeps you alive) ----------
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.02
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_SYMBOL=1
MAX_CONSECUTIVE_LOSSES=3
BREAKER_COOLDOWN_MINUTES=60
MAX_USD_EXPOSURE=2

# ---------- entries: require several filters to agree ----------
# 2 = loose (more trades), 4 = balanced (default), 5-6 = very selective
MIN_SCORE=4
FAST_EMA=9
SLOW_EMA=21
TREND_EMA=50
HTF_EMA=100
RSI_PERIOD=14
ATR_PERIOD=14
TREND_ADX=22
RANGE_ADX=18
ALLOW_RANGE_TRADES=true

# ---------- sessions (UTC) ----------
SESSION_START_HOUR=7
SESSION_END_HOUR=20
TRADE_FRIDAY=true

# ---------- exits, in R and ATR ----------
ATR_SL_MULT=1.5
ATR_TP_MULT=3.0
PARTIAL_AT_R=1.0
PARTIAL_FRACTION=0.5
BREAKEVEN_AT_R=1.0
TRAIL_START_R=1.2
TRAIL_ATR_MULT=1.2

# ---------- execution guards ----------
MAX_SPREAD_POINTS=25
MIN_ATR_POINTS=30
COOLDOWN_MINUTES=10
DEVIATION_POINTS=10
MAGIC=26091701
POLL_SECONDS=2

# ---------- server ----------
DB_PATH=bot_state.db
CORS_ORIGINS=*

# ---------- scanner (skannar hela marknaden, skickar entry/SL/TP) ----------
SCAN_TIMEFRAMES=5,15,60
SCAN_MIN_SCORE=5
SCAN_MAX_SYMBOLS=40

# ---------- notifications ----------
# Empty = send to every channel that is configured. Use "telegram,sms" to pick.
NOTIFY_CHANNELS=
# Telegram: @BotFather -> /newbot -> token, then message the bot and read
# https://api.telegram.org/bot<TOKEN>/getUpdates for the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SMS via Twilio (paid, a few cents per message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=
