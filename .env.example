# API token used by the phone. Leave empty to auto-generate one into .api_token
API_TOKEN=

# Where the MT5 terminal lives (only needed if auto-detect fails)
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Trading
DRY_RUN=true
SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD
TIMEFRAME_MINUTES=5
RISK_PER_TRADE=0.0025
MAX_DAILY_LOSS=0.02

# Server
DB_PATH=bot_state.db
# Comma separated origins, or * while testing locally
CORS_ORIGINS=*
